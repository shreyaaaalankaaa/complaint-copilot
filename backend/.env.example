# Copy to .env and fill in.
# The app runs WITHOUT a Groq key (deterministic fallback engine), but set one
# to exercise the real LangGraph + Groq path.
GROQ_API_KEY=
FAST_MODEL=gemma2-9b-it
REASONING_MODEL=llama-3.3-70b-versatile
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa
CORS_ORIGINS=http://localhost:5173
